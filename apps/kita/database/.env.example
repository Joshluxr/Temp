# apps/kita/database/.env.example — TEMPLATE ONLY (T-PLAT-02 executable isolation)
#
# Copy to .env for local use; never commit a filled-in copy.
#
# *** ISOLATED TEST DATABASE ONLY ***
#  - NEVER point DATABASE_URL at production, staging, or any real money book.
#  - NEVER put real credentials in this file or in any .env derived from it.
#    The values below are throwaway conventions for the ephemeral cluster
#    created by apps/kita/database/scripts/provision-cluster.sh.
#  - Port convention: 54339 is reserved for the Kita isolated test cluster.
#    The smoke runner (apps/kita/database/src/smoke.mjs) fail-closes unless the
#    URL is exactly kita_core_test @ 127.0.0.1:54339 with login role kita_test,
#    so an accidental production/staging URL can never execute the fixture.
#  - The cluster listens on loopback only and lives under .cluster/ (gitignored);
#    tearing it down destroys all data. Nothing here is recoverable or secret.

DATABASE_URL=postgres://kita_test@127.0.0.1:54339/kita_core_test

# If you prefer discrete variables (some tools read these instead):
# PGHOST=127.0.0.1
# PGPORT=54339
# PGUSER=kita_test
# PGDATABASE=kita_core_test
# PGPASSWORD=            # leave empty; provision-cluster.sh uses trust auth on loopback
