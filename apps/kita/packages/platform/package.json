      "types": "./migrate-core.ts",
      "default": "./migrate-core.ts"
    },
    "./workers/validate-build-baseline.worker": {
      "types": "./workers/validate-build-baseline.worker.ts",
      "default": "./workers/validate-build-baseline.worker.ts"
    },
    "./workers/migrate-core.worker": {
      "types": "./workers/migrate-core.worker.ts",
      "default": "./workers/migrate-core.worker.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test __tests__/test-plat-01.spec.ts __tests__/test-plat-02.spec.ts"
  },
  "dependencies": {
    "@kita/contracts": "*"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
